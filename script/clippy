#!/usr/bin/env bash
# Lints the given packages (default: the whole workspace) without linting dependencies.

set -euo pipefail

if [[ ! " $* " == *" -p "* && ! " $* " == *" --package "* ]]; then
    set -- "$@" --workspace
fi

set -x
"${CARGO:-cargo}" clippy --no-deps "$@" --all-targets -- --deny warnings
