[Desktop Entry]
Version=1.0
Type=Application
Name=$APP_NAME
GenericName=Text Editor
Comment=A minimal, LSP-first code editor.
TryExec=$APP_CLI
StartupNotify=true
StartupWMClass=$APP_ID
Exec=$APP_CLI %U
Icon=$APP_ICON
Categories=Utility;TextEditor;Development;IDE;
Keywords=oxed;editor;lsp;
MimeType=text/plain;application/x-zerosize;x-scheme-handler/oxed;
Actions=NewWorkspace;

[Desktop Action NewWorkspace]
Exec=$APP_CLI --new %U
Name=Open a new workspace
